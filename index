    .spotlight-card::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(
        520px circle at var(--mouse-x) var(--mouse-y),
        rgba(245, 158, 11, 0.06),
